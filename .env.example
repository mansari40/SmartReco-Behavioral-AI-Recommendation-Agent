# Database
DATABASE_URL=sqlite+aiosqlite:///./smartreco.db

# Auth
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mesh API 
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_CHAT_MODEL=openai/gpt-4o
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small

# Vector store (Chroma, local persistent)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=products

# LangSmith (observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your_key_here
LANGCHAIN_PROJECT=smartreco-agent

ENVIRONMENT=development