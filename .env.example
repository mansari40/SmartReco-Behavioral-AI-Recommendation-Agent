# --- Database ---
# Local dev (SQLite + Chroma fallback vector store):
DATABASE_URL=sqlite+aiosqlite:///./upulse.db
# Production (Render) — PostgreSQL with the pgvector extension. The app
# auto-creates the schema, admin, 52 courses, and embeddings on startup.
# DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# --- Auth ---
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Admin bootstrap (auto-created idempotently at startup) ---
ADMIN_EMAIL=upulse@admin.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- OpenRouter API ---
OPENROUTER_API_KEY=rsk_your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# For free tier: use openrouter/free (auto-routes to free models)
# For quality: use openai/gpt-4o-mini (requires paid credits)
# Other options: deepseek/deepseek-chat, meta-llama/llama-2-70b-chat, etc.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Maximum tokens per LLM request (limits token usage to prevent credit exhaustion)
# Set lower (512-1024) for free tier or low credits; higher (2048-4096) for paid accounts
OPENROUTER_MAX_TOKENS=4096

# Set to true to skip real embedding calls (deterministic mock vectors).
# Real semantic retrieval requires false.
MOCK_EMBEDDINGS=false

# Vector store — Chroma is used ONLY as the local dev/test fallback while
# DATABASE_URL is SQLite. Production (PostgreSQL) uses pgvector and these
# settings are ignored.
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=products

# LangSmith (observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your_key_here
LANGCHAIN_PROJECT=upulse-agent

ENVIRONMENT=development

# Public base URL used to build absolute links in transactional emails
# (e.g. password reset). Locally the dev server; on Render this is injected
# automatically from the deployed service URL.
PUBLIC_BASE_URL=http://localhost:8000
