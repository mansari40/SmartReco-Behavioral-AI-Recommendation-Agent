# Database
DATABASE_URL=sqlite+aiosqlite:///./upulse.db

# Auth
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenRouter API
OPENROUTER_API_KEY=rsk_your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Note: openrouter/free daily quota is small and can be exhausted mid-demo;
# use a paid model for reliable runs. Some providers (e.g. deepseek via
# OpenRouter) ignore response_format and return empty bodies — gpt-4o-mini
# is a safe default.
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Set to true to skip real embedding calls (deterministic mock vectors).
# Real semantic retrieval requires false.
MOCK_EMBEDDINGS=false

# Vector store (Chroma, local persistent)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=products

# LangSmith (observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your_key_here
LANGCHAIN_PROJECT=upulse-agent

ENVIRONMENT=development