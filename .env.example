# Database
DATABASE_URL=sqlite+aiosqlite:///./upulse.db

# Auth
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenRouter API
OPENROUTER_API_KEY=rsk_your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# For free tier: use openrouter/free (auto-routes to free models)
# For quality: use openai/gpt-4o-mini (requires paid credits)
# Other options: deepseek/deepseek-chat, meta-llama/llama-2-70b-chat, etc.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Maximum tokens per LLM request (limits token usage to prevent credit exhaustion)
# Set lower (512-1024) for free tier or low credits; higher (2048-4096) for paid accounts
OPENROUTER_MAX_TOKENS=4096

# Set to true to skip real embedding calls (deterministic mock vectors).
# Real semantic retrieval requires false.
MOCK_EMBEDDINGS=false

# Vector store (Chroma, local persistent)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=products

# LangSmith (observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your_key_here
LANGCHAIN_PROJECT=upulse-agent

ENVIRONMENT=development